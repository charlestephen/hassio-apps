        "jsonBody": "={{ JSON.stringify({ timestampFrom: Date.now() - $('Config').first().json.lookbackMinutes * 60000, timestampTo: Date.now(), pageSize: 100, pageNumber: 0, threatTypes: ['THREAT', 'HONEYPOT'] }) }}"
      }
