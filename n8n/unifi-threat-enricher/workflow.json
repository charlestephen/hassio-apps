    {
      "id": "16144268-2023-4493-8e7d-f718b5f04cd1",
      "name": "Verify Slack",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        500
      ],
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst cfg = $('Config').first().json;\nconst secret = $env.SLACK_SIGNING_SECRET;\nif (!secret) throw new Error('Set SLACK_SIGNING_SECRET in the n8n environment');\n\nconst headers = cfg.request.headers;\nconst timestamp = Number(headers['x-slack-request-timestamp']);\nif (!timestamp || Math.abs(Date.now() / 1000 - timestamp) > 300) throw new Error('Stale or missing Slack timestamp');\n\nconst raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nconst expected = Buffer.from('v0=' + crypto.createHmac('sha256', secret).update('v0:' + timestamp + ':' + raw).digest('hex'));\nconst provided = Buffer.from(headers['x-slack-signature'] ?? '');\nif (expected.length !== provided.length || !crypto.timingSafeEqual(expected, provided)) throw new Error('Invalid Slack signature');\n\nconst field = raw.split('&').find((part) => part.startsWith('payload=')) ?? '';\nconst payload = JSON.parse(decodeURIComponent(field.slice('payload='.length).replace(/\\+/g, ' ')));\nif (cfg.allowedSlackUserIds.length && !cfg.allowedSlackUserIds.includes(payload.user.id)) {\n  throw new Error('Slack user ' + payload.user.id + ' is not allowed to run actions');\n}\n\nconst [clicked] = payload.actions ?? [];\nif (!clicked || clicked.url) return [];\nconst id = clicked.action_id;\nreturn [{ json: { action: id.slice(0, id.indexOf(':')), target: clicked.value, userId: payload.user.id, responseUrl: payload.response_url } }];\n"
      }
    },
