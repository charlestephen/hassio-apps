      ],
      "parameters": {
        "jsCode": "const config = {\n  gatewayUrl: 'https://192.168.1.1',\n  site: 'default',\n  slackChannel: '#security',\n  lookbackMinutes: 15,\n  // Lets the rest of a burst land in the threat log before it is read.\n  settleSeconds: 45,\n  muteHours: 24,\n  // _id of a UniFi IPv4 address group that a block policy already drops. Needed for \"Block IP\".\n  firewallGroupId: '',\n  // ID of a Protect Alarm Manager incoming webhook. Leave empty to hide the siren button.\n  protectWebhookId: '',\n  // Slack user IDs allowed to press buttons. Empty allows anyone in the channel.\n  allowedSlackUserIds: [],\n};\n\nconst item = $input.first();\nconst source = $('Slack actions').isExecuted ? 'slack' : 'unifi';\nreturn [{ json: { ...config, source, request: item.json }, binary: item.binary }];\n"
      }
    },
