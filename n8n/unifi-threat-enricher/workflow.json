    {
      "id": "0ced14cb-4145-46ea-b22d-01f6a9d2cb42",
      "name": "Build Slack message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2220,
        100
      ],
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst state = $getWorkflowStaticData('global');\nconst now = Date.now();\nstate.muted = Object.fromEntries(Object.entries(state.muted ?? {}).filter(([, until]) => until > now));\n\nconst threats = $input.all()\n  .map(({ json }) => (Array.isArray(json.data) ? json.data[0] : json.data) ?? json)\n  .filter((t) => t?.signature && !state.muted[t.signature]);\nif (!threats.length) return [];\n\nconst tally = (key) => {\n  const groups = new Map();\n  for (const t of threats) {\n    const k = key(t);\n    if (!k) continue;\n    const g = groups.get(k) ?? { key: k, count: 0, t };\n    g.count += 1;\n    groups.set(k, g);\n  }\n  return [...groups.values()].sort((a, b) => b.count - a.count);\n};\nconst tick = '\\x60';\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst top = (groups, line) => groups.slice(0, 5).map(line).join('\\n') + (groups.length > 5 ? '\\n_+' + (groups.length - 5) + ' more_' : '');\n\nconst signatures = tally((t) => t.signature);\nconst sources = tally((t) => t.server_ip);\nconst clients = tally((t) => t.client_mac);\nconst risks = ['high', 'medium', 'low'];\nconst highest = risks.find((r) => threats.some((t) => t.risk === r)) ?? 'unknown';\nconst dot = { high: ':red_circle:', medium: ':large_orange_circle:', low: ':large_yellow_circle:' }[highest] ?? ':white_circle:';\nconst blocked = threats.filter((t) => t.action === 'blocked').length;\n\nconst button = (text, action, value, style) => ({\n  type: 'button',\n  text: { type: 'plain_text', text: text.slice(0, 75) },\n  action_id: (action + ':' + value).slice(0, 255),\n  value,\n  ...(style && { style }),\n});\n\nconst actions = [\n  ...sources.slice(0, 3).map((g) => button('Block IP ' + g.key, 'block_ip', g.key, 'danger')),\n  ...clients.slice(0, 2).map((g) => button('Block client ' + (g.t.client_name || g.key), 'block_client', g.key, 'danger')),\n  button('Mute ' + signatures[0].key, 'mute', signatures[0].key),\n  ...(cfg.protectWebhookId ? [button('Sound siren', 'siren', 'siren')] : []),\n  { type: 'button', text: { type: 'plain_text', text: 'Open UniFi' }, action_id: 'open:unifi', url: cfg.gatewayUrl },\n];\n\nconst plural = threats.length === 1 ? '' : 's';\nconst text = threats.length + ' threat' + plural + ' in the last ' + cfg.lookbackMinutes + ' min (highest risk: ' + highest + ')';\nconst blocks = [\n  { type: 'header', text: { type: 'plain_text', text: threats.length + ' threat' + plural + ' in the last ' + cfg.lookbackMinutes + ' min' } },\n  {\n    type: 'context',\n    elements: [{ type: 'mrkdwn', text: dot + ' Highest risk *' + highest + '*  |  Blocked ' + blocked + '/' + threats.length + '  |  ' + esc(cfg.request.body?.name ?? 'Threat Detected') }],\n  },\n  {\n    type: 'section',\n    text: { type: 'mrkdwn', text: '*Signatures*\\n' + top(signatures, (g) => '• *' + g.count + '×* ' + esc(g.t.signature) + ' _(' + esc(g.t.risk) + ', ' + esc(g.t.signature_type) + ')_') },\n  },\n  {\n    type: 'section',\n    text: {\n      type: 'mrkdwn',\n      text: '*Sources*\\n' + top(sources, (g) => '• *' + g.count + '×* ' + tick + esc(g.key) + tick + ' ' + esc(g.t.counterpart_location || g.t.counterpart_country_code || '') + ' · ' + esc(g.t.threat_direction) + ' · ' + esc(g.t.action)),\n    },\n  },\n  ...(clients.length\n    ? [{ type: 'section', text: { type: 'mrkdwn', text: '*Clients*\\n' + top(clients, (g) => '• *' + g.count + '×* ' + esc(g.t.client_name || 'unknown') + ' ' + tick + esc(g.key) + tick) } }]\n    : []),\n  { type: 'actions', elements: actions },\n];\n\nreturn [{ json: { channel: cfg.slackChannel, text, blocks } }];\n"
      }
    },
