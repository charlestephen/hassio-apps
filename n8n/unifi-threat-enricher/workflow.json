    {
      "id": "92007ae0-6636-40ce-8a2e-0bd53307378b",
      "name": "New threats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        100
      ],
      "parameters": {
        "jsCode": "const state = $getWorkflowStaticData('global');\nconst now = Date.now();\nstate.seen = Object.fromEntries(Object.entries(state.seen ?? {}).filter(([, at]) => now - at < 86400000));\n\nconst entries = $input.all().flatMap(({ json }) => json.data ?? json.items ?? (json.id ? [json] : []));\nconst ids = [...new Set(entries.map((e) => e.parameters?.THREAT_LOG_ID?.id ?? e.id).filter(Boolean))]\n  .filter((id) => !state.seen[id]);\nfor (const id of ids) state.seen[id] = now;\nreturn ids.map((id) => ({ json: { id } }));\n"
      }
    },
    {
      "id": "27b22c2b-4fef-475e-aadb-372d5ef7b27a",
      "name": "Threat details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        100
      ],
      "parameters": {
        "options": {
          "allowUnauthorizedCerts": true
        },
        "url": "={{ $('Config').first().json.gatewayUrl }}/proxy/network/v2/api/site/{{ $('Config').first().json.site }}/inspection-logs/threats/{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Cookie",
              "value": "={{ $('Session').first().json.cookie }}"
            },
            {
              "name": "X-CSRF-Token",
