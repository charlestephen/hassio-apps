      ],
      "parameters": {
        "options": {
          "allowUnauthorizedCerts": true
        },
        "method": "POST",
        "url": "={{ $('Config').first().json.gatewayUrl }}/proxy/network/v2/api/site/{{ $('Config').first().json.site }}/system-log/threat-alert",
        "sendHeaders": true,
        "headerParameters": {
