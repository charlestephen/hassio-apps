#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Handle Technitium DNS service termination
# ==============================================================================
readonly exit_code_container=$(</run/s6-linux-init-container-results/exitcode)
readonly exit_code_service="${1}"
readonly exit_code_signal="${2}"

bashio::log.info \
    "Technitium DNS exited with code ${exit_code_service}" \
    "(by signal ${exit_code_signal})"

# Exit 256 = s6 signalled the service (graceful shutdown path)
if [[ "${exit_code_service}" -eq 256 ]]; then
    if [[ "${exit_code_container}" -eq 0 ]]; then
        echo $((128 + exit_code_signal)) \
            > /run/s6-linux-init-container-results/exitcode
    fi
    # SIGTERM (15) = clean stop requested — halt the s6 tree
    [[ "${exit_code_signal}" -eq 15 ]] && exec /run/s6/basedir/bin/halt
elif [[ "${exit_code_service}" -ne 0 ]]; then
    # Non-zero exit = fatal crash — propagate code and halt container
    if [[ "${exit_code_container}" -eq 0 ]]; then
        echo "${exit_code_service}" \
            > /run/s6-linux-init-container-results/exitcode
    fi
    exec /run/s6/basedir/bin/halt
fi
