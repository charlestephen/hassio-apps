#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Run Technitium DNS Server (longrun: supervised by s6)
# ==============================================================================
# DNS_SERVER_* env vars seed Technitium's config only on first boot — they are
# ignored once dns.config already exists. Upstream reference:
#   https://github.com/TechnitiumSoftware/DnsServer/blob/master/DockerEnvironmentVariables.md

readonly data_dir="/data/technitium"

# ---- Web-service bind address ------------------------------------------------
web_service_local_addresses="$(bashio::config 'web_service_local_addresses')"
if ! bashio::var.has_value "${web_service_local_addresses}"; then
    web_service_local_addresses="0.0.0.0"
fi
export DNS_SERVER_WEB_SERVICE_LOCAL_ADDRESSES="${web_service_local_addresses}"
bashio::log.info "Web service first-run bind: ${DNS_SERVER_WEB_SERVICE_LOCAL_ADDRESSES}"

# ---- Typed option → env var exports ------------------------------------------
export_if_set() {
    local option="${1}" env_var="${2}" value
    value="$(bashio::config "${option}")"
    if bashio::var.has_value "${value}"; then
        export "${env_var}=${value}"
        if [[ "${env_var}" == *PASSWORD* || "${env_var}" == *SECRET* ]]; then
            bashio::log.info "Exported ${env_var} (value hidden)"
        else
            bashio::log.info "Exported ${env_var}=${value}"
        fi
    fi
}

export_if_set 'dns_server_domain'                         'DNS_SERVER_DOMAIN'
export_if_set 'dns_server_admin_password'                 'DNS_SERVER_ADMIN_PASSWORD'
export_if_set 'dns_server_recursion'                      'DNS_SERVER_RECURSION'
export_if_set 'dns_server_forwarders'                     'DNS_SERVER_FORWARDERS'
export_if_set 'dns_server_forwarder_protocol'             'DNS_SERVER_FORWARDER_PROTOCOL'
export_if_set 'dns_server_block_list_urls'                'DNS_SERVER_BLOCK_LIST_URLS'

# Booleans must be exported as literal "true"/"false" for Technitium to parse them.
if bashio::config.has_value 'dns_server_prefer_ipv6'; then
    if bashio::config.true 'dns_server_prefer_ipv6'; then
        export DNS_SERVER_PREFER_IPV6="true"
    else
        export DNS_SERVER_PREFER_IPV6="false"
    fi
    bashio::log.info "Exported DNS_SERVER_PREFER_IPV6=${DNS_SERVER_PREFER_IPV6}"
fi

if bashio::config.has_value 'dns_server_enable_blocking'; then
    if bashio::config.true 'dns_server_enable_blocking'; then
        export DNS_SERVER_ENABLE_BLOCKING="true"
    else
        export DNS_SERVER_ENABLE_BLOCKING="false"
    fi
    bashio::log.info "Exported DNS_SERVER_ENABLE_BLOCKING=${DNS_SERVER_ENABLE_BLOCKING}"
fi

if bashio::config.has_value 'dns_server_optional_protocol_dns_over_http'; then
    if bashio::config.true 'dns_server_optional_protocol_dns_over_http'; then
        export DNS_SERVER_OPTIONAL_PROTOCOL_DNS_OVER_HTTP="true"
    else
        export DNS_SERVER_OPTIONAL_PROTOCOL_DNS_OVER_HTTP="false"
    fi
    bashio::log.info "Exported DNS_SERVER_OPTIONAL_PROTOCOL_DNS_OVER_HTTP=${DNS_SERVER_OPTIONAL_PROTOCOL_DNS_OVER_HTTP}"
fi

# ---- Free-form DNS_SERVER_* passthrough --------------------------------------
if bashio::config.has_value 'extra_env'; then
    for entry in $(bashio::config 'extra_env|keys'); do
        line="$(bashio::config "extra_env[${entry}]")"
        key="${line%%=*}"
        value="${line#*=}"
        if [[ -n "${key}" && "${key}" != "${line}" ]]; then
            export "${key}=${value}"
            if [[ "${key}" == *PASSWORD* || "${key}" == *SECRET* ]]; then
                bashio::log.info "Exported ${key} from extra_env (value hidden)"
            else
                bashio::log.info "Exported ${key}=${value} from extra_env"
            fi
        else
            bashio::log.warning "Skipping malformed extra_env entry: '${line}'"
        fi
    done
fi

bashio::log.info "Starting Technitium DNS Server ..."
exec dotnet /opt/technitium/dns/DnsServerApp.dll "${data_dir}"
