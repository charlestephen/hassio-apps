#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
until curl -sf http://localhost:8080/api/v0/metrics >/dev/null 2>&1; do
    bashio::log.info "outlet: waiting for the Akvorado orchestrator..."
    sleep 2
done
bashio::log.info "Starting Akvorado outlet ${AKVORADO_VERSION:-}..."
exec /usr/local/bin/akvorado outlet http://localhost:8080
