#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Handle error-pages service termination
# ==============================================================================

declare exit_code=${1}

if [ "${exit_code}" -ne 0 ] && [ "${exit_code}" -ne 256 ]; then
  bashio::log.warning "error-pages exited with code ${exit_code}, restarting ..."
fi
