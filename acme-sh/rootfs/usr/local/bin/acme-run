#!/bin/sh
# Translate Home Assistant options into acme.sh commands, upgrade the client,
# and leave supercronic running the renewal schedule.
set -u

OPTIONS=/data/options.json
ACME="${LE_WORKING_DIR:-/acmebin}/acme.sh"
HOOK_DIR="${LE_WORKING_DIR:-/acmebin}/deploy"
export LE_WORKING_DIR="${LE_WORKING_DIR:-/acmebin}"
export LE_CONFIG_HOME="${LE_CONFIG_HOME:-/data/acme.sh}"
export HOME="$LE_CONFIG_HOME"

# The image default would make `acme.sh --cron` upgrade itself in the middle
# of a run, after which custom deploy hooks linked below would be gone.
# Upgrade explicitly, then re-link, then renew.
unset AUTO_UPGRADE

log() {
  printf '%s\n' "[acme.sh] $*"
}

die() {
  log "$*"
  exit 1
}

load_env() {
  if [ ! -f "$OPTIONS" ]; then
    die "missing $OPTIONS"
  fi
  mkdir -p "$LE_CONFIG_HOME" /ssl /config/deploy /tmp
  envfile=/tmp/acme-env
  : > "$envfile"
  chmod 600 "$envfile"
  jq -r '
    (.env_vars // [])[]
    | (.name // "") as $n
    | select($n | test("^[A-Za-z_][A-Za-z0-9_]*$") | not)
    | "invalid env var name: \($n)"
  ' "$OPTIONS" | while IFS= read -r msg; do
    [ -n "$msg" ] && log "$msg"
  done
  jq -r '
    (.env_vars // [])[]
    | (.name // "") as $n
    | select($n | test("^[A-Za-z_][A-Za-z0-9_]*$"))
    | "export \($n)=\(.value // "" | @sh)"
  ' "$OPTIONS" > "$envfile"
  # shellcheck disable=SC1090
  . "$envfile"
}

strip_saved_autoupgrade() {
  conf="$LE_CONFIG_HOME/account.conf"
  if [ ! -f "$conf" ]; then
    return 0
  fi
  grep -v '^AUTO_UPGRADE=' "$conf" > "$conf.new" || true
  mv "$conf.new" "$conf"
  chmod 600 "$conf"
}

upgrade_client() {
  log "checking for an acme.sh upgrade"
  if ! "$ACME" --upgrade --home "$LE_WORKING_DIR" --config-home "$LE_CONFIG_HOME"; then
    log "upgrade failed; continuing with the installed copy"
  fi
  strip_saved_autoupgrade
}

link_custom_hooks() {
  mkdir -p "$HOOK_DIR" /config/deploy
  for src in /config/deploy/*.sh; do
    [ -f "$src" ] || continue
    base=$(basename "$src")
    case "$base" in
      *[!A-Za-z0-9_.-]*)
        log "ignoring custom hook $base"
        continue
        ;;
    esac
    ln -sf "$src" "$HOOK_DIR/$base"
    log "custom deploy hook ${base%.sh}"
  done
}

valid_name() {
  case "$1" in
    "" | *[!A-Za-z0-9._*-]*) return 1 ;;
  esac
  return 0
}

# acme.sh's default key is EC, which it would otherwise store in ${domain}_ecc.
# Pin the store to $domain so the shared path matches the configured name.
# Set only for this command: a leaked DOMAIN_PATH would make --cron reuse it.
run_acme() {
  domain=$1
  shift
  if [ -f "$LE_CONFIG_HOME/$domain/$domain.conf" ] || [ ! -f "$LE_CONFIG_HOME/${domain}_ecc/$domain.conf" ]; then
    DOMAIN_PATH="$LE_CONFIG_HOME/$domain" "$ACME" "$@" --home "$LE_WORKING_DIR" --config-home "$LE_CONFIG_HOME"
  else
    "$ACME" "$@" --home "$LE_WORKING_DIR" --config-home "$LE_CONFIG_HOME"
  fi
}

# /data and /ssl are different mounts. mv across them is a copy, and the
# source has to stay intact if that copy fails.
link_store() {
  name=$1
  target=$2
  link="$LE_CONFIG_HOME/$name"

  if [ -L "$link" ]; then
    current=$(readlink "$link")
    if [ "$current" = "$target" ]; then
      mkdir -p "$target"
      return 0
    fi
    if [ -d "$current" ] && [ ! -L "$current" ]; then
      if [ -d "$target" ] && [ -z "$(ls -A "$target")" ]; then
        rmdir "$target"
      fi
      if [ -e "$target" ]; then
        log "certificate store $target already exists; leaving $link in place"
        return 0
      fi
      mkdir -p "$(dirname "$target")"
      if ! mv "$current" "$target"; then
        log "could not move $current to $target"
        return 1
      fi
    fi
    mkdir -p "$target"
    ln -sfn "$target" "$link"
    log "certificate store $link -> $target"
    return 0
  fi
  if [ -e "$link" ] && [ ! -d "$link" ]; then
    log "not replacing $link with a certificate store link"
    return 0
  fi

  mkdir -p /ssl/acme.sh
  if [ -d "$link" ]; then
    if [ -d "$target" ] && [ -z "$(ls -A "$target")" ]; then
      rmdir "$target"
    fi
    if [ -e "$target" ]; then
      log "certificate store $target already exists; leaving $link in place"
      return 0
    fi
    if ! mv "$link" "$target"; then
      log "could not move $link to $target"
      return 1
    fi
  else
    mkdir -p "$target"
  fi
  ln -sfn "$target" "$link"
  log "certificate store $link -> $target"
}

# The default store is /data/acme.sh/$domain -> /ssl/acme.sh/$domain.
# An existing EC directory is folded into that name when the plain path is free.
ensure_domain_store() {
  domain=$1
  link="$LE_CONFIG_HOME/$domain"
  ecc="$LE_CONFIG_HOME/${domain}_ecc"

  if [ ! -e "$link" ] && [ ! -L "$link" ]; then
    if [ -d "$ecc" ] && [ ! -L "$ecc" ]; then
      mv "$ecc" "$link"
    elif [ -L "$ecc" ]; then
      ln -sfn "$(readlink "$ecc")" "$link"
      rm -f "$ecc"
    fi
  fi

  if [ -e "$link" ] || [ -L "$link" ] || { [ ! -e "$ecc" ] && [ ! -L "$ecc" ]; }; then
    link_store "$domain" "/ssl/acme.sh/$domain"
  fi
  if [ -L "$ecc" ] || [ -d "$ecc" ]; then
    link_store "${domain}_ecc" "/ssl/acme.sh/${domain}_ecc"
  fi
}

# Renewal recopies whatever Le_Real* paths were saved. Drop the ones that
# point at /ssl/$domain so that directory is not created again.
drop_copied_install_paths() {
  domain=$1
  prefix="/ssl/${domain}/"
  for name in "$domain" "${domain}_ecc"; do
    conf="$LE_CONFIG_HOME/$name/$domain.conf"
    [ -f "$conf" ] || continue
    tmp="$conf.new"
    : > "$tmp"
    changed=0
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        Le_RealCertPath=* | Le_RealKeyPath=* | Le_RealCACertPath=* | Le_RealFullChainPath=*)
          value=${line#*=}
          value=${value#\'}
          value=${value%\'}
          value=${value#\"}
          value=${value%\"}
          case "$value" in
            "$prefix"*)
              changed=1
              continue
              ;;
          esac
          ;;
      esac
      printf '%s\n' "$line" >> "$tmp"
    done < "$conf"
    if [ "$changed" -eq 1 ]; then
      mv "$tmp" "$conf"
      chmod 600 "$conf"
      log "removed install paths under /ssl/$domain"
    else
      rm -f "$tmp"
    fi
  done
}

prepare_stores() {
  mkdir -p /ssl/acme.sh "$LE_CONFIG_HOME"
  jq -c '(.certificates // [])[]' "$OPTIONS" | while IFS= read -r cert; do
    domain=$(printf '%s' "$cert" | jq -r '.domain // ""')
    if valid_name "$domain"; then
      ensure_domain_store "$domain"
      drop_copied_install_paths "$domain"
    fi
  done
}

copy_cert() {
  domain=$1
  ha=$2
  if [ "$ha" != "true" ]; then
    return 0
  fi
  src=""
  for dir in "$LE_CONFIG_HOME/$domain" "$LE_CONFIG_HOME/${domain}_ecc"; do
    if [ -f "$dir/fullchain.cer" ]; then
      if [ -z "$src" ] || [ "$dir/fullchain.cer" -nt "$src/fullchain.cer" ]; then
        src=$dir
      fi
    fi
  done
  if [ -z "$src" ]; then
    log "no certificate files for $domain"
    return 1
  fi
  key=""
  for candidate in "$src/$domain.key" "$src/"*.key; do
    if [ -f "$candidate" ]; then
      key=$candidate
      break
    fi
  done
  if [ -z "$key" ]; then
    log "no private key for $domain"
    return 1
  fi
  note=/tmp/acme-ha-domain
  if [ -f "$note" ]; then
    log "Home Assistant /ssl certificate replaced: $(cat "$note") -> $domain"
  fi
  cp "$src/fullchain.cer" /ssl/fullchain.pem
  cp "$key" /ssl/privkey.pem
  chmod 600 /ssl/privkey.pem
  printf '%s\n' "$domain" > "$note"
  log "Home Assistant certificate is $domain"
}

sync_one() {
  cert=$1
  domain=$(printf '%s' "$cert" | jq -r '.domain // ""')
  alt_raw=$(printf '%s' "$cert" | jq -r '.alt_domains // ""')
  challenge=$(printf '%s' "$cert" | jq -r '.challenge // ""')
  dns_hook=$(printf '%s' "$cert" | jq -r '.dns_hook // ""')
  webroot=$(printf '%s' "$cert" | jq -r '.webroot // ""')
  hooks_raw=$(printf '%s' "$cert" | jq -r '.deploy_hooks // ""')
  reload_cmd=$(printf '%s' "$cert" | jq -r '.reload_cmd // ""')
  ha=$(printf '%s' "$cert" | jq -r '.home_assistant // false')

  if ! valid_name "$domain"; then
    log "skipping invalid domain"
    return 0
  fi

  set -- --issue --server "$CA" -d "$domain"
  set -f
  # shellcheck disable=SC2086
  for alt in $(printf '%s' "$alt_raw" | tr ',' ' '); do
    if valid_name "$alt"; then
      set -- "$@" -d "$alt"
    else
      log "skipping invalid alternate name on $domain"
    fi
  done
  set +f
  case "$challenge" in
    dns)
      case "$dns_hook" in
        dns_[A-Za-z0-9_]*) ;;
        *)
          log "skipping $domain: dns challenge needs a dns_* hook name"
          return 0
          ;;
      esac
      set -- "$@" --dns "$dns_hook"
      ;;
    standalone)
      set -- "$@" --standalone
      ;;
    webroot)
      case "$webroot" in
        /share/* | /share | /data/* | /data | /config/* | /config | /ssl/* | /ssl) ;;
        *)
          log "skipping $domain: webroot must be under /share, /data, /config, or /ssl"
          return 0
          ;;
      esac
      mkdir -p "$webroot"
      set -- "$@" --webroot "$webroot"
      ;;
    *)
      log "skipping $domain: unknown challenge"
      return 0
      ;;
  esac
  if [ -n "$reload_cmd" ]; then
    set -- "$@" --reloadcmd "$reload_cmd"
  fi

  log "issuing $domain ($challenge)"
  if ! run_acme "$domain" "$@"; then
    log "issue failed for $domain"
  fi

  hooks=""
  invalid_hook=0
  set -f
  # shellcheck disable=SC2086
  for hook in $(printf '%s' "$hooks_raw" | tr ',' ' '); do
    case "$hook" in
      "" | *[!A-Za-z0-9_-]*)
        log "skipping deploy for $domain: invalid hook name"
        invalid_hook=1
        break
        ;;
    esac
    if [ -z "$hooks" ]; then
      hooks=$hook
    else
      hooks="$hooks,$hook"
    fi
  done
  set +f
  if [ "$invalid_hook" -eq 0 ] && [ -n "$hooks" ]; then
    log "deploying $domain with $hooks"
    if ! run_acme "$domain" --deploy -d "$domain" --deploy-hook "$hooks"; then
      log "deploy failed for $domain"
    fi
  fi

  if [ -n "$reload_cmd" ] && { [ -f "$LE_CONFIG_HOME/$domain/$domain.conf" ] || [ -f "$LE_CONFIG_HOME/${domain}_ecc/$domain.conf" ]; }; then
    log "saving reload command for $domain"
    if ! run_acme "$domain" --install-cert -d "$domain" --reloadcmd "$reload_cmd"; then
      log "could not save reload command for $domain"
    fi
  fi

  copy_cert "$domain" "$ha" || true
}

sync_certs() {
  rm -f /tmp/acme-ha-domain
  jq -c '(.certificates // [])[]' "$OPTIONS" | while IFS= read -r cert; do
    sync_one "$cert"
  done
}

copy_all() {
  rm -f /tmp/acme-ha-domain
  jq -c '(.certificates // [])[]' "$OPTIONS" | while IFS= read -r cert; do
    domain=$(printf '%s' "$cert" | jq -r '.domain // ""')
    ha=$(printf '%s' "$cert" | jq -r '.home_assistant // false')
    if valid_name "$domain"; then
      copy_cert "$domain" "$ha" || true
    fi
  done
}

write_crontab() {
  if [ -f "$LE_CONFIG_HOME/crontab" ]; then
    return 0
  fi
  now=$(date -u +%s)
  minute=$((now % 60))
  hour=$((now / 60 % 6))
  printf '%s %s,%s,%s,%s * * * /usr/local/bin/acme-run cron\n' \
    "$minute" "$hour" "$((hour + 6))" "$((hour + 12))" "$((hour + 18))" \
    > "$LE_CONFIG_HOME/crontab"
  log "renewal schedule written to $LE_CONFIG_HOME/crontab"
}

CA=$(jq -r '.ca // "letsencrypt"' "$OPTIONS" 2>/dev/null || true)
case "${CA:-}" in
  letsencrypt | letsencrypt_test | zerossl) ;;
  *) CA=letsencrypt ;;
esac

load_env
upgrade_client
link_custom_hooks
prepare_stores

mode=${1:-start}
if [ "$mode" = "cron" ]; then
  log "renewal run"
  "$ACME" --cron --home "$LE_WORKING_DIR" --config-home "$LE_CONFIG_HOME" || log "renewal returned non-zero"
  strip_saved_autoupgrade
  copy_all
  exit 0
fi

email=$(jq -r '.email // ""' "$OPTIONS")
case "$email" in
  ?*@?*.?*)
    log "registering account $email at $CA"
    "$ACME" --register-account -m "$email" --server "$CA" --home "$LE_WORKING_DIR" --config-home "$LE_CONFIG_HOME" \
      || log "account registration returned non-zero"
    "$ACME" --set-default-ca --server "$CA" --home "$LE_WORKING_DIR" --config-home "$LE_CONFIG_HOME" \
      || log "could not set the default CA"
    sync_certs
    ;;
  "")
    log "email is empty; certificates will not be issued until it is set"
    ;;
  *)
    log "email is not usable; certificates will not be issued"
    ;;
esac

strip_saved_autoupgrade
write_crontab
log "starting renewal daemon"
exec /usr/bin/supercronic "$LE_CONFIG_HOME/crontab"
